# ---------------------------------------------------------------------------
# Copy to .env.local for local development. In production set the same keys in
# Vercel → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Access links -----------------------------------------------------------
# Generate with:  npm run tokens
# Anyone holding a link has that role, so treat them as passwords.
TOKEN_JUSTLIFE_ADMIN=
TOKEN_PC_ADMIN=
TOKEN_VIEWER=

# --- Google Sheets ----------------------------------------------------------
# The spreadsheet id from its URL:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=1W3VWXJRLXUMpnuunatpnwyajjiuF9E8j_nzctHtQpg0

# Service account credentials. Share the spreadsheet with this email as EDITOR.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the whole private key including the BEGIN/END lines. Newlines may be
# written literally as \n — both forms work.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional — only if your tab names differ from these defaults.
# SHEET_TAB_CASH=Cash Collection
# SHEET_TAB_CANX=Cancellations
# SHEET_TAB_RESPONSES=_Responses
# SHEET_TAB_AUDIT=_Audit

# --- Reminder email ---------------------------------------------------------
# Two transports. SMTP wins whenever SMTP_HOST is set; otherwise Resend is used.
#
# SMTP sends from a real mailbox, so it reaches external recipients immediately
# with no DNS changes. Resend needs a verified sending domain before it will
# deliver to anyone other than the Resend account owner.
#
#   Office 365 : smtp.office365.com  port 587
#   Gmail      : smtp.gmail.com      port 587   (needs an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to true only on port 465; leave unset for 587.
# SMTP_SECURE=false

RESEND_API_KEY=
# Comma separated. These are the people who get chased.
# Real values are set in .env.local and in Vercel, deliberately not committed
# here so the address list does not travel with the repository.
REMINDER_TO=
REMINDER_CC=
# IMPORTANT: with onboarding@resend.dev, Resend only delivers to the address
# that owns the Resend account. To reach anyone else you must verify a sending
# domain in Resend and change this to an address on that domain.
REMINDER_FROM=Perfect Choice Dashboard <onboarding@resend.dev>
REMINDER_REPLY_TO=
REMINDER_SUBJECT=Action required — Daily Cash Collection & Cancellation updates
REMINDER_SIGNOFF=Shahbaz

# --- Screenshot uploads -----------------------------------------------------
# Created automatically when you connect a Blob store in Vercel → Storage.
BLOB_READ_WRITE_TOKEN=

# --- Behaviour --------------------------------------------------------------
DASHBOARD_TIMEZONE=Asia/Dubai
DASHBOARD_CURRENCY=AED
# How to read dates typed as TEXT. Real date cells are unambiguous and ignore
# this. DMY means "01/08/2026" is 1 August.
DATE_TEXT_ORDER=DMY

# Public URL, used for the button inside the reminder email. On Vercel this is
# detected automatically; set it if you use a custom domain.
# APP_BASE_URL=https://perfect-choice.vercel.app
